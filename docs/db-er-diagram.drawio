        <mxCell id="schema-title" parent="1" value="Aether: PostgreSQL schema | ORM + Alembic 093e886bdc8e" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry x="0" y="0" width="2040" height="50" as="geometry" />
        </mxCell>
        <mxCell id="schema-constraints" parent="1" value="&lt;b&gt;Keys and constraints&lt;/b&gt;&lt;br&gt;PK = primary key; FK = foreign key; [auto] = auto-increment. FK columns reference parent id.&lt;br&gt;users: UNIQUE INDEX ix_lower_login ON lower(login).&lt;br&gt;chat_members PK (user_id, chat_id); message_reads PK (user_id, message_id), constraint message_reads_pk.&lt;br&gt;message_content.message_id: PK + FK, no auto-increment; message content is optional.&lt;br&gt;TIMESTAMPTZ = timestamp with time zone. Only deleted_at and edited_at allow NULL.&lt;br&gt;No FK ON DELETE CASCADE. ORM delete-orphan cascades: see DATABASE.md." vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry x="0" y="1120" width="2040" height="200" as="geometry" />
        </mxCell>
        <mxCell id="schema-enums" parent="1" value="&lt;b&gt;Native PostgreSQL ENUM types&lt;/b&gt;&lt;br&gt;chat_type_enum: private, group, channel&lt;br&gt;chat_member_role_enum: owner, admin, member&lt;br&gt;mime_type_enum: image/jpeg, image/png, image/gif, image/webp, audio/mpeg, audio/ogg, video/mp4, video/webm, application/pdf, text/plain, application/octet-stream&lt;br&gt;No ENUM defaults. No additional CHECK constraints or unique attachment positions." vertex="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry x="0" y="1350" width="2040" height="170" as="geometry" />
        </mxCell>
      </root>
